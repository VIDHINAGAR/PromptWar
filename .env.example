# ─────────────────────────────────────────────
#  StressDNA AI — AI Provider Keys
#  Copy this file to ".env" and fill in keys.
#  The app tries each provider in order and
#  silently falls back if one is unavailable.
#  You only need ONE key for live AI — but
#  adding all three gives maximum reliability.
# ─────────────────────────────────────────────

# 1. Google Gemini (primary) — free at aistudio.google.com
VITE_GEMINI_API_KEY=

# 2. Groq (fallback 1) — free at console.groq.com
VITE_GROQ_API_KEY=

# 3. OpenRouter (fallback 2) — free models at openrouter.ai
VITE_OPENROUTER_API_KEY=

# Optional overrides
# VITE_GEMINI_MODEL=gemini-2.0-flash
# VITE_GROQ_MODEL=llama-3.3-70b-versatile
# VITE_OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
